<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB"/>
      <stop offset="100%" style="stop-color:#E0F0FF"/>
    </linearGradient>
    <linearGradient id="building" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#4A90D9"/>
      <stop offset="100%" style="stop-color:#2C5F8A"/>
    </linearGradient>
    <linearGradient id="ground" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#90C080"/>
      <stop offset="100%" style="stop-color:#609050"/>
    </linearGradient>
  </defs>
  
  <rect width="800" height="600" fill="url(#sky)"/>
  <circle cx="700" cy="80" r="40" fill="#FFD700" opacity="0.8"/>
  
  <!-- Suelo -->
  <rect x="0" y="450" width="800" height="150" fill="url(#ground)"/>
  
  <!-- Biblioteca/laboratorio -->
  <g>
    <rect x="250" y="180" width="300" height="270" fill="url(#building)" rx="3"/>
    <rect x="240" y="170" width="320" height="15" fill="#3A7BC8" rx="2"/>
    
    <!-- Aulas/laboratorios con puertas -->
    <rect x="270" y="210" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    <rect x="340" y="210" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    <rect x="410" y="210" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    <rect x="480" y="210" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    
    <rect x="270" y="290" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    <rect x="340" y="290" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    <rect x="410" y="290" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    <rect x="480" y="290" width="50" height="60" fill="#87CEEB" stroke="#3A7BC8" stroke-width="2" rx="2"/>
    
    <!-- Gran puerta central -->
    <rect x="365" y="380" width="70" height="70" fill="#5C4033" rx="3"/>
    <rect x="370" y="385" width="60" height="60" fill="#8B7355" rx="2"/>
    <circle cx="420" cy="415" r="3" fill="#FFD700"/>
    
    <rect x="345" y="450" width="110" height="10" fill="#A0A0A0"/>
  </g>
  
  <!-- Árbol grande -->
  <rect x="150" y="380" width="10" height="70" fill="#6B4226"/>
  <circle cx="155" cy="370" r="30" fill="#228B22"/>
  <circle cx="140" cy="375" r="20" fill="#2E8B2E"/>
  <circle cx="170" cy="375" r="20" fill="#2E8B2E"/>
  
  <!-- Bancos -->
  <rect x="580" y="455" width="40" height="8" fill="#8B7355" rx="2"/>
  <rect x="580" y="463" width="40" height="3" fill="#6B4226"/>
  
  <text x="400" y="530" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#333" font-weight="bold">
    Bloque B — Biblioteca
  </text>
  <text x="400" y="555" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#666">
    [Plantilla de escenario — reemplazar con imagen real de UPB]
  </text>
</svg>
