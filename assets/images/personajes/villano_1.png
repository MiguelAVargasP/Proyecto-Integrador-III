<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500" viewBox="0 0 400 500">
  <defs>
    <linearGradient id="bgA" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="skinA" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f5cba7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e8b78a;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="shirtA" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#293241;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bgA)" rx="12"/>
  
  <!-- body/shoulders -->
  <ellipse cx="200" cy="480" rx="145" ry="60" fill="#293241"/>
  
  <!-- neck -->
  <rect x="180" y="280" width="40" height="50" rx="6" fill="url(#skinA)"/>
  
  <!-- head -->
  <ellipse cx="200" cy="230" rx="65" ry="80" fill="url(#skinA)"/>
  
  <!-- hair -->
  <path d="M135 220 Q132 160 170 140 Q200 120 230 140 Q268 160 265 220 Q270 200 250 185 Q220 170 200 170 Q180 170 150 185 Q130 200 135 220 Z" fill="#0f0f1a"/>
  
  <!-- eyes -->
  <ellipse cx="180" cy="235" rx="6" ry="7" fill="#1a1a2e"/>
  <ellipse cx="220" cy="235" rx="6" ry="7" fill="#1a1a2e"/>
  <circle cx="181" cy="233" r="2" fill="white" opacity="0.7"/>
  <circle cx="221" cy="233" r="2" fill="white" opacity="0.7"/>
  
  <!-- eyebrows -->
  <path d="M170 220 Q180 217 192 221" stroke="#0f0f1a" stroke-width="2.5" fill="none"/>
  <path d="M208 221 Q220 217 230 220" stroke="#0f0f1a" stroke-width="2.5" fill="none"/>
  
  <!-- nose -->
  <path d="M200 240 Q196 252 200 256 Q204 252 200 240" stroke="#d4a373" stroke-width="1.5" fill="none"/>
  
  <!-- mouth -->
  <path d="M188 268 Q200 274 212 268" stroke="#c07060" stroke-width="2" fill="none"/>
  
  <!-- glasses -->
  <circle cx="180" cy="235" r="18" fill="none" stroke="#8d6e63" stroke-width="2.5"/>
  <circle cx="220" cy="235" r="18" fill="none" stroke="#8d6e63" stroke-width="2.5"/>
  <path d="M198 235 L202 235" stroke="#8d6e63" stroke-width="2.5"/>
  
  <!-- shoulder/clavicles -->
  <path d="M60 440 Q200 420 340 440" stroke="#3d405b" stroke-width="6" fill="none" stroke-linecap="round"/>
  
  <!-- collar detalle -->
  <path d="M175 330 Q200 340 225 330" stroke="#4a4e69" stroke-width="2" fill="none"/>
</svg>
