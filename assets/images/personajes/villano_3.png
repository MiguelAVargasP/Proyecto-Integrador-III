<svg xmlns="http://www.w3.org/2000/svg" width="400" height="500" viewBox="0 0 400 500">
  <defs>
    <linearGradient id="bgC" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0a3d62;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#062a45;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="skinC" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f0d5b8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e0bfa0;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="shirtC" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0a3d62;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bgC)" rx="12"/>
  
  <ellipse cx="200" cy="480" rx="145" ry="60" fill="#0a3d62"/>
  <rect x="180" y="280" width="40" height="50" rx="6" fill="url(#skinC)"/>
  <ellipse cx="200" cy="230" rx="65" ry="80" fill="url(#skinC)"/>
  
  <!-- short hair -->
  <path d="M135 220 Q130 165 170 150 Q200 135 230 150 Q270 165 265 220 Q268 200 250 185 Q220 170 200 170 Q180 170 150 185 Q132 200 135 220 Z" fill="#3d2b1f"/>
  
  <ellipse cx="180" cy="235" rx="6" ry="7" fill="#1a1a2e"/>
  <ellipse cx="220" cy="235" rx="6" ry="7" fill="#1a1a2e"/>
  <circle cx="181" cy="233" r="2" fill="white" opacity="0.7"/>
  <circle cx="221" cy="233" r="2" fill="white" opacity="0.7"/>
  
  <path d="M170 220 Q180 217 192 221" stroke="#3d2b1f" stroke-width="2.5" fill="none"/>
  <path d="M208 221 Q220 217 230 220" stroke="#3d2b1f" stroke-width="2.5" fill="none"/>
  
  <path d="M200 240 Q196 254 200 258 Q204 254 200 240" stroke="#c4956a" stroke-width="1.5" fill="none"/>
  
  <!-- smile -->
  <path d="M188 270 Q200 278 212 270" stroke="#b5654a" stroke-width="2.5" fill="none"/>
  
  <!-- ears -->
  <ellipse cx="135" cy="230" rx="8" ry="12" fill="url(#skinC)"/>
  <ellipse cx="265" cy="230" rx="8" ry="12" fill="url(#skinC)"/>
  
  <path d="M60 440 Q200 420 340 440" stroke="#0e4d7a" stroke-width="6" fill="none" stroke-linecap="round"/>
  
  <!-- tie -->
  <path d="M195 330 L200 380 L205 330 Z" fill="#FFC107"/>
  <circle cx="200" cy="340" r="4" fill="#FF8F00"/>
</svg>
